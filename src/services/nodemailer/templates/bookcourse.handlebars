<!-- Email Template -->
<div
  style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f5f5f5; padding: 40px 20px;"
>
  <!-- Main Container -->
  <div
    style="max-width: 700px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);"
  >

    <!-- Header with Gradient Background -->
    <div
      style="background: linear-gradient(135deg, #1f2937 0%, #111827 100%); padding: 40px 30px; text-align: center;"
    >
      <img
        src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1745396912/Amber_Users/vs3ygjavp7jwjp7gdqws.png"
        alt="Amber Training Logo"
        style="max-width: 160px; height: auto; margin-bottom: 15px;"
      />
      <h1
        style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 600;"
      >New Course Booking Request</h1>
      <p style="color: #d1d5db; margin: 8px 0 0 0; font-size: 14px;">Action
        Required</p>
    </div>

    <!-- Content Area -->
    <div style="padding: 40px 30px;">
      <!-- Alert Banner -->
      <div
        style="background: #fef3c7; border-left: 4px solid #fbbf24; padding: 16px; border-radius: 8px; margin-bottom: 30px;"
      >
        <p
          style="color: #92400e; font-size: 14px; margin: 0; font-weight: 500;"
        >
          A new booking request requires your attention and approval.
        </p>
      </div>

      <!-- Course Information Section -->
      <div style="margin-bottom: 32px;">
        <h2
          style="color: #ff7c22; font-size: 18px; font-weight: 600; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 2px solid #ff7c22;"
        > Course Information</h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div style="background: #f9fafb; padding: 12px; border-radius: 8px;">
            <p
              style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
            >Course Name</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
            >{{course.name}}</p>
          </div>

          <div style="background: #f9fafb; padding: 12px; border-radius: 8px;">
            <p
              style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
            >Duration</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
            >{{course.duration}}</p>
          </div>

          <div style="background: #f9fafb; padding: 12px; border-radius: 8px;">
            <p
              style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
            >Certification</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
            >{{course.certification}}</p>
          </div>

          <div style="background: #f9fafb; padding: 12px; border-radius: 8px;">
            <p
              style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
            >Price</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
            >£{{course.price}}</p>
          </div>
        </div>
      </div>

      <!-- Applicant Information Section -->
      <div style="margin-bottom: 32px;">
        <h2
          style="color: #ff7c22; font-size: 18px; font-weight: 600; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 2px solid #ff7c22;"
        > Applicant Details</h2>

        <div
          style="background: #f9fafb; padding: 16px; border-radius: 8px; border-left: 4px solid #ff7c22;"
        >
          <div
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;"
          >
            <div>
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Full Name</p>
              <p
                style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
              >{{fullName}}</p>
            </div>

            <div>
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Phone</p>
              <p
                style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
              >
                <a
                  href="tel:{{phone}}"
                  style="color: #ff7c22; text-decoration: none;"
                >{{phone}}</a>
              </p>
            </div>
          </div>

          <div
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;"
          >
            <div>
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Email</p>
              <p
                style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
              >
                <a
                  href="mailto:{{email}}"
                  style="color: #ff7c22; text-decoration: none;"
                >{{email}}</a>
              </p>
            </div>

            <div>
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Organization</p>
              <p
                style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
              >{{organizationName}}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Details Section -->
      <div style="margin-bottom: 32px;">
        <h2
          style="color: #ff7c22; font-size: 18px; font-weight: 600; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 2px solid #ff7c22;"
        >📋 Booking Details</h2>

        <div style="background: #f9fafb; padding: 16px; border-radius: 8px;">
          <div
            style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;"
          >
            <div>
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Number of Participants</p>
              <p
                style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
              >{{numberOfParticipants}}</p>
            </div>

            <div>
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Location Preference</p>
              <p
                style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
              >{{locationPreference}}</p>
            </div>
          </div>

          {{#if formattedAddress}}
            <div style="margin-bottom: 16px;">
              <p
                style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
              >Training Address</p>
              <p
                style="color: #1f2937; font-size: 15px; margin: 0; line-height: 1.6;"
              >
                {{formattedAddress}}
              </p>
            </div>
          {{/if}}

          <div>
            <p
              style="color: #6b7280; font-size: 12px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;"
            >Preferred Training Dates</p>
            <div
              style="background: #ffffff; padding: 12px; border-left: 3px solid #ff7c22; border-radius: 4px;"
            >
              <p
                style="color: #1f2937; font-size: 14px; margin: 0; line-height: 1.8;"
              >
                {{preferredDates}}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Required Section -->
      <div
        style="background: #eff6ff; border-left: 4px solid #3b82f6; padding: 16px; border-radius: 8px; margin-bottom: 30px;"
      >
        <p
          style="color: #1e40af; font-size: 14px; margin: 0; line-height: 1.6;"
        >
          <strong>Next Steps:</strong>
          Please review this booking request and approve or reject it in the
          admin dashboard. The applicant will be notified of your decision.
        </p>
      </div>

      <!-- CTA Button -->
      {{! <div style="text-align: center; margin-bottom: 20px;">
        <a
          href="https://booking.ambertraining.co.uk/approve-booking"
          style="display: inline-block; background: linear-gradient(135deg, #ff7c22 0%, #ff6b1a 100%); color: white; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 15px; transition: all 0.3s ease;"
        >
          Review Booking in Dashboard
        </a>
      </div> }}

      <p
        style="font-size: 13px; color: #9ca3af; margin: 0; text-align: center;"
      >
        Received:
        {{createdAt}}
      </p>
    </div>

    <!-- Footer -->
    <div
      style="background: #f9fafb; padding: 24px 30px; border-top: 1px solid #e5e7eb; text-align: center;"
    >
      <p style="color: #9ca3af; font-size: 12px; margin: 0 0 8px 0;">
        Amber Training Admin Notification
      </p>
      <p style="color: #d1d5db; font-size: 11px; margin: 0;">
        © 2026 Amber Training. All rights reserved.
      </p>
    </div>
  </div>
</div>