<!-- Email Template -->
<div
  style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f5f5f5; padding: 40px 20px;"
>
  <!-- Main Container -->
  <div
    style="max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);"
  >

    <!-- Header with Gradient Background -->
    <div
      style="background: linear-gradient(135deg, #1f2937 0%, #111827 100%); padding: 40px 30px; text-align: center;"
    >
      <img
        src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1745396912/Amber_Users/vs3ygjavp7jwjp7gdqws.png"
        alt="Amber Training Logo"
        style="max-width: 160px; height: auto; margin-bottom: 15px;"
      />
      <h1
        style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 600;"
      >Booking Confirmed</h1>
      <p style="color: #d1d5db; margin: 8px 0 0 0; font-size: 14px;">We've
        received your request</p>
    </div>

    <!-- Content Area -->
    <div style="padding: 40px 30px;">
      <!-- Greeting -->
      <p
        style="font-size: 16px; color: #1f2937; margin: 0 0 24px 0; font-weight: 500;"
      >
        Hello
        <strong>{{fullName}}</strong>,
      </p>

      <!-- Main Message -->
      <p
        style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 24px 0;"
      >
        Thank you for choosing
        <strong>Amber Training</strong>! We're excited to help you develop
        essential first aid and safety skills. We've received your booking
        request and will contact you shortly to confirm all the details.
      </p>

      <!-- Course Summary Card -->
      <div
        style="background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%); border-left: 4px solid #ff7c22; padding: 20px; border-radius: 8px; margin: 30px 0;"
      >
        <h3
          style="color: #ff7c22; margin: 0 0 16px 0; font-size: 16px; font-weight: 600;"
        >Course Details</h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <p
              style="color: #6b7280; font-size: 13px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px;"
            >Course</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0 0 6px 0;"
            >{{course.name}}</p>
          </div>

          <div>
            <p
              style="color: #6b7280; font-size: 13px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px;"
            >Duration</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0 0 6px 0;"
            >{{course.duration}}</p>
          </div>

          <div>
            <p
              style="color: #6b7280; font-size: 13px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px;"
            >Certification</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0 0 6px 0;"
            >{{course.certification}}</p>
          </div>

          <div>
            <p
              style="color: #6b7280; font-size: 13px; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px;"
            >Participants</p>
            <p
              style="color: #1f2937; font-size: 15px; font-weight: 600; margin: 0;"
            >{{numberOfParticipants}}</p>
          </div>
        </div>
      </div>

      <!-- Preferred Dates -->
      <div style="margin: 28px 0;">
        <h3
          style="color: #1f2937; font-size: 14px; font-weight: 600; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280;"
        >Preferred Training Dates</h3>
        <div style="background: #f9fafb; border-radius: 8px; padding: 16px;">
          {{#each preferredDates}}
            <div
              style="display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #e5e7eb; color: #1f2937; font-size: 14px;"
            >
              <span
                style="color: #ff7c22; margin-right: 10px; font-weight: 600;"
              >✓</span>
              <span>{{this.date}} at {{this.time}}</span>
            </div>
          {{/each}}
        </div>
      </div>

      <!-- Next Steps -->
      <div
        style="background: #fef3c7; border-left: 4px solid #fbbf24; padding: 16px; border-radius: 8px; margin: 28px 0;"
      >
        <p
          style="color: #92400e; font-size: 14px; margin: 0; line-height: 1.5;"
        >
          <strong>What's Next?</strong>
          Our team will review your booking and contact you within 24 hours to
          confirm your training date, time, and any additional requirements.
        </p>
      </div>

      <!-- Contact Info -->
      <div
        style="background: #f3f4f6; padding: 16px; border-radius: 8px; margin: 28px 0; text-align: center;"
      >
        <p
          style="color: #6b7280; font-size: 13px; margin: 0 0 12px 0;"
        >Questions? Get in touch</p>
        <p style="margin: 8px 0;">
          <a
            href="tel:+447763658885"
            style="color: #ff7c22; text-decoration: none; font-weight: 600; font-size: 14px;"
          >+44 7763 658885</a>
        </p>
        <p style="margin: 8px 0;">
          <a
            href="mailto:support@ambertraining.co.uk"
            style="color: #ff7c22; text-decoration: none; font-weight: 600; font-size: 14px;"
          >support@ambertraining.co.uk</a>
        </p>
      </div>

      <!-- Closing -->
      <p
        style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 28px 0 0 0;"
      >
        We look forward to training with you and helping you develop crucial
        life-saving skills!
      </p>

      <p style="font-size: 15px; color: #6b7280; margin: 24px 0 0 0;">
        Best regards,<br />
        <strong style="color: #1f2937;">The Amber Training Team</strong>
      </p>
    </div>

    <!-- Footer -->
    <div
      style="background: #f9fafb; padding: 24px 30px; border-top: 1px solid #e5e7eb; text-align: center;"
    >
      <p style="color: #9ca3af; font-size: 12px; margin: 0 0 8px 0;">
        Ofqual Regulated | FAA Approved | NUCO Instructor
      </p>
      <p style="color: #d1d5db; font-size: 11px; margin: 0;">
        © 2026 Amber Training. All rights reserved.
      </p>
    </div>
  </div>
</div>