<!-- Email Template -->
<div
  style="font-family: Arial, sans-serif; background-color: #f9f9f9; padding: 30px;"
>
  <!-- Grey Header with Logo -->
  <div
    style="background-color: #e0e0e0; padding: 20px 0; text-align: center; border-radius: 8px 8px 0 0; max-width: 600px; margin: 0 auto;"
  >
    <img
      src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1742470541/Amber_Users/i66ramiru2d9doyfo7hx.png"
      alt="Amber Training Logo"
      style="max-width: 150px; height: auto;"
    />
  </div>

  <!-- White Content Area -->
  <div
    style="max-width: 600px; margin: 0 auto; background: #e0e0e0; padding: 25px; border-radius: 0 0 8px 8px; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.05);"
  >
    <h2 style="color: #333;">Booking Request Received</h2>
    <p style="font-size: 16px; color: #444;">Dear {{fullName}},</p>
    <p style="font-size: 15px; color: #444;">
      Thank you for your interest in our course
      <strong>{{course.name}}</strong>. We have received your booking request
      and will contact you shortly to confirm the next steps.
    </p>

    <h3 style="color: #ff7c22;">Course Summary</h3>
    <ul style="list-style: none; padding: 0; color: #555; font-size: 15px;">
      <li><strong>Duration:</strong> {{course.duration}}</li>
      <li><strong>Mode:</strong> {{course.mode}}</li>
      <li><strong>Preferred Dates:</strong> {{formattedPreferredDates}}</li>
    </ul>

    <p style="font-size: 15px; color: #666; margin-top: 30px;">We look forward
      to working with you!</p>
  </div>
</div>