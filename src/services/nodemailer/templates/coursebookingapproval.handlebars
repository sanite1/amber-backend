<div
  style="font-family: Arial, sans-serif; background-color: #f9f9f9; padding: 30px;"
>
  <div class="header" style="text-align: center; margin-bottom: 20px;">
    <img
      src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1745396912/Amber_Users/vs3ygjavp7jwjp7gdqws.png"
      alt="Amber Training Logo"
      style="max-width: 150px;"
    />
  </div>
  <div style="background: #ffffff; padding: 25px; border-radius: 8px;">
    <h2 style="color: #333;">Booking Approved</h2>
    <p style="font-size: 16px;">Hi {{fullName}},</p>
    <p style="font-size: 15px;">Your booking for
      <strong>{{course.name}}</strong>
      has been approved. Here are your booking details:</p>

    <ul style="font-size: 14px; color: #555;">
      <li><strong>Name:</strong> {{fullName}}</li>
      <li><strong>Course:</strong> {{course.name}}</li>
      <li><strong>Duration:</strong> {{course.duration}}</li>
      <li><strong>Mode:</strong> {{course.mode}}</li>
      <li><strong>Certification:</strong> {{course.certification}}</li>
      <li><strong>Price:</strong> £{{course.price}}</li>
      <li><strong>Preferred Dates:</strong> {{formattedPreferredDates}}</li>
      <!-- Conditionally display the address if provided -->
      {{#if formattedAddress}}
        <li style="color: #555; font-size: 14px;"><strong>Address:</strong>
          {{formattedAddress}}</li>
      {{/if}}
    </ul>

    <p>Thank you for choosing Amber Training. An invoice has been generated and
      sent along with this email.</p>
  </div>
</div>